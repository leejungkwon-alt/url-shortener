node_modules/

# 로컬 테스트/영속 데이터 (JSON 저장소 파일, urls.json.tmp 포함)
data/
*.tmp

# 환경 변수 파일 (비밀값 포함 가능 — 커밋 금지)
.env
.env.*
!.env.example

# 로그
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 테스트/커버리지 산출물
coverage/

# 에디터 / OS 부산물
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
