# 로컬 개발용 환경 변수 예시
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채우고 `npm run dev:env` 로 실행합니다.
# (.env 는 .gitignore 에 의해 커밋되지 않습니다.)

# 서버 포트 (Render 등 PaaS는 PORT를 자동 주입합니다)
PORT=3000

# 단축 URL 생성 시 사용할 외부 기준 주소
# 미설정 시 http://localhost:PORT 로 생성되므로, 배포 환경에서는 반드시 지정하세요.
# Render: RENDER_EXTERNAL_URL 이 자동 주입되며, 미설정 시 이 값을 사용합니다.
# BASE_URL=https://my-shortener.onrender.com

# 저장소 드라이버: memory | json
STORAGE_DRIVER=json
STORAGE_FILE=./data/urls.json

# 생성할 짧은 코드 길이 (기본 7)
SHORT_CODE_LENGTH=7

# 리다이렉트 상태 코드: 301 | 302
REDIRECT_STATUS=302
